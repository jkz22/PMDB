# Virtual environments
env/
.venv/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# macOS
.DS_Store
outputs/modal/

# physical clean pipeline: full-resolution arrays are rebuilt with scripts/build_clean.py
outputs/clean*/**/*.tif
outputs/clean*/**/preview.png
outputs/clean*/qc_report.html

# imported harmonisation pipelines: half-res arrays are rebuilt with scripts/build_harmonise_ext.py (~6 min)
cache*/harmonised_ext/*/half/*.npz

# shift-harmonised arrays are rebuilt with scripts/build_harmonise_shift.py
cache/harmonised_shift/*/half/*.npz
cache_heldout/harmonised_shift/*/half/*.npz
cache/harmonised_shift/*/model.npz
cache_heldout/harmonised_shift/*/model.npz
data_test/

# agent workflow files
.claude/
